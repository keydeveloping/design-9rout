# Docker Compose Environment Variables
# Browser node runs now read 9router URL/key from localStorage `9router.runtimeSettings`
# and send them per request via X-KeyWorkflow-Router-URL / X-KeyWorkflow-Router-Key headers.
# Server-side and Docker-only runtime flows can still use env config below.
NINEROUTER_URL=http://host.docker.internal:20128
NINEROUTER_KEY=your_9router_key_here
PUBLIC_BASE_URL=http://localhost:8000
ALLOW_LOCAL_REFERENCE_IMAGES=true
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=keyworkflow
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/keyworkflow
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
S3_PRESIGNED_EXPIRES_SECONDS=604800
