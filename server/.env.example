# Browser node runs no longer fall back to these env values.
# Set browser-local runtime settings in UI/localStorage `9router.runtimeSettings` instead.
# These env vars still apply to backend-initiated runtime calls.
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=your_9router_key_here
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOW_LOCAL_REFERENCE_IMAGES=true
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=keyworkflow
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/keyworkflow
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
S3_PRESIGNED_EXPIRES_SECONDS=604800
