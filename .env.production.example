# VPS production config for Docker Compose + Caddy + MinIO
# Copy to .env and replace placeholders before deploy.
# Keep ./data beside docker-compose.prod.yml to preserve existing MinIO objects.

APP_DOMAIN=workflow.keywdev.cloud
PUBLIC_BASE_URL=https://workflow.keywdev.cloud

MINIO_API_DOMAIN=minio-api.keywdev.cloud
MINIO_CONSOLE_DOMAIN=minio-console.keywdev.cloud

# Browser/user runtime uses 9router Settings in UI.
# Optional only for backend-only flows.
NINEROUTER_URL=
NINEROUTER_KEY=

ALLOW_LOCAL_REFERENCE_IMAGES=false
DATA_DIR=/home/appuser/data

STORAGE_BACKEND=minio
# Public MinIO endpoint keeps presigned download URLs browser-reachable.
S3_ENDPOINT_URL=https://minio-api.keywdev.cloud
S3_ACCESS_KEY_ID=keyworkflow_minio
S3_SECRET_ACCESS_KEY=change_this_to_a_long_random_secret
S3_BUCKET=keyworkflow
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=false
S3_PRESIGNED_EXPIRES_SECONDS=604800
